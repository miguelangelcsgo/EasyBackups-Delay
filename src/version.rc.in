// Recurso de versión de Windows — generado por CMake (configure_file) a partir de
// la versión del proyecto, para que Explorador → Propiedades → Detalles muestre la versión.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "MAVSoft"
            VALUE "FileDescription",  "EasyBackupandDelay - copia en la nube + filtros de delay para OBS Studio"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "EasyBackupandDelay"
            VALUE "OriginalFilename", "EasyBackupandDelay.dll"
            VALUE "ProductName",      "EasyBackupandDelay"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
            VALUE "LegalCopyright",   "\xA9 MAVSoft - miguelangelcsgo"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
